{
  "$comment": "SCRATCH-PROJECT hooks for the tracer-bullet experiments ONLY. This is a project-scoped config inside experiments/tracer-bullet/scratch-project/ — it is NOT the repo-root .claude and NOT the founder's global ~/.claude. It registers agent-lens against the five base tracer-bullet hooks plus SubagentStart/Stop (Q1/Q2) and PreCompact/PostCompact (Q4). All async:true = fire-and-forget, so a slow/absent collector never harms the scratch session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "agent-lens hook", "async": true }]
      }
    ]
  }
}
