{
  "$comment": "Deterministic secret-scrubbing rules for tracer-bullet fixtures. Each rule redacts a known secret SHAPE to a stable placeholder so fixtures stay diff-stable and shape-preserving. This is the auditable source of truth referenced by SCRUBBING.md. Order matters: earlier rules win on overlapping matches. Never relax a rule without a manual re-review of every fixture.",
  "rules": [
    {
      "name": "anthropic-api-key",
      "pattern": "sk-ant-[A-Za-z0-9_-]{8,}",
      "replacement": "[REDACTED-ANTHROPIC-KEY]"
    },
    {
      "name": "openai-api-key",
      "pattern": "sk-(?!ant-)[A-Za-z0-9]{16,}",
      "replacement": "[REDACTED-OPENAI-KEY]"
    },
    {
      "name": "aws-access-key-id",
      "pattern": "AKIA[0-9A-Z]{16}",
      "replacement": "[REDACTED-AWS-KEY-ID]"
    },
    {
      "name": "github-token",
      "pattern": "gh[pousr]_[A-Za-z0-9]{16,}",
      "replacement": "[REDACTED-GITHUB-TOKEN]"
    },
    {
      "name": "jwt",
      "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "replacement": "[REDACTED-JWT]"
    },
    {
      "name": "bearer-header",
      "pattern": "(?i)(authorization\"?\\s*[:=]\\s*\"?)bearer\\s+[A-Za-z0-9._-]+",
      "replacement": "$1Bearer REDACTED"
    },
    {
      "name": "agentlens-token-header",
      "pattern": "(?i)(x-agentlens-token\"?\\s*[:=]\\s*\"?)[A-Za-z0-9._-]+",
      "replacement": "$1REDACTED"
    },
    {
      "name": "keyish-assignment",
      "pattern": "(?i)([A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD)\"?\\s*[:=]\\s*\"?)[^\"\\s,}]+",
      "replacement": "$1REDACTED"
    },
    {
      "name": "email",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "replacement": "user@example.com"
    },
    {
      "name": "private-ip-10",
      "pattern": "\\b10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
      "replacement": "10.0.0.0"
    },
    {
      "name": "private-ip-192-168",
      "pattern": "\\b192\\.168\\.\\d{1,3}\\.\\d{1,3}\\b",
      "replacement": "192.168.0.0"
    },
    {
      "name": "private-ip-172",
      "pattern": "\\b172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}\\b",
      "replacement": "172.16.0.0"
    }
  ],
  "anonymize": {
    "$comment": "Path/identity anonymization applied AFTER regex redaction. Set homeDir/username at runtime via --home and --user flags; these placeholders document intent.",
    "homePlaceholder": "/home/USER",
    "userPlaceholder": "USER"
  }
}
