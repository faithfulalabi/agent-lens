      "input_bytes": 80,
      "input_storage": "inline",
      "text": "1\t// Q3 bait — emit EXACTLY N bytes of deterministic, marker-rich text to stdout.\n2\t//\n3\t// The hook `tool_output` truncation threshold (Q3) is probed by driving Claude\n4\t// Code to run tools whose output spans size bands {1KB, 100KB, 1MB, 10MB}. This\n5\t// script is that tool: `node emit.mjs 1MB` writes exactly 1,048,576 bytes. The\n6\t// stream is seeded with byte-offset markers (\"<<@000000512>>\") every 512 bytes\n7\t// so the captured (possibly truncated) `tool_output` reveals the exact cutoff\n8\t// offset. Output is pure ASCII → 1 char == 1 byte, so length math is exact.\n9\t//\n10\t// Run: node experiments/tracer-bullet/emit.mjs <size>\n11\t//   <size> = an integer byte count, or a band label: 1KB | 100KB | 1MB | 10MB.\n12\t// Importable: `import { buildPayload, parseSize } from \"./emit.mjs\"`.\n13\t\n14\timport process from 'node:process';\n15\t\n16\t/** Named size bands for the Q3 sweep, in bytes. */\n17\texport const SIZE_BANDS = {\n18\t  '1KB': 1024,\n19\t  '100KB': 100 * 1024,\n20\t  '1MB': 1024 * 1024,\n21\t  '10MB': 10 * 1024 * 1024,\n22\t};\n23\t\n24\t/** Emit a marker every this many bytes so truncation offset is recoverable. */\n25\tconst MARKER_STRIDE = 512;\n26\t\n27\t/**\n28\t * Resolve a size argument to an exact byte count. Accepts a band label\n29\t * (case-insensitive) or a positive integer string. Throws on anything else.\n30\t *\n31\t * @param {string} arg\n32\t * @returns {number}\n33\t */\n34\texport function parseSize(arg) {\n35\t  if (arg === undefined || arg === '') {\n36\t    throw new Error('size required: a byte count or one of 1KB|100KB|1MB|10MB');\n37\t  }\n38\t  const band = SIZE_BANDS[arg.toUpperCase()];\n39\t  if (band !== undefined) return band;\n40\t  if (/^\\d+$/.test(arg)) {\n41\t    const n = Number(arg);\n42\t    if (n > 0) return n;\n43\t  }\n44\t  throw new Error(`invalid size \"${arg}\": use a byte count or 1KB|100KB|1MB|10MB`);\n45\t}\n46\t\n47\t/**\n48\t * Build a payload of EXACTLY `bytes` ASCII characters. A marker of the form\n49\t * `<<@000000000>>` (zero-padded absolute byte offset) is written at every\n50\t * MARKER_STRIDE boundary; the gaps are filled with a repeating filler. The\n51\t * result is truncated/padded to land on the exact requested length.\n52\t *\n53\t * @param {number} bytes - target length; must be a positive integer.\n54\t * @returns {string} exactly `bytes` characters (== bytes, ASCII).\n55\t */\n56\texport function buildPayload(bytes) {\n57\t  if (!Number.isInteger(bytes) || bytes <= 0) {\n58\t    throw new Error(`bytes must be a positive integer, got ${bytes}`);\n59\t  }\n60\t  const out = [];\n61\t  let written = 0;\n62\t  const filler = '.';\n63\t  while (written < bytes) {\n64\t    if (written % MARKER_STRIDE === 0) {\n65\t      const marker = `<<@${String(written).padStart(9, '0')}>>`;\n66\t      out.push(marker);\n67\t      written += marker.length;\n68\t    } else {\n69\t      out.push(filler);\n70\t      written += 1;\n71\t    }\n72\t  }\n73\t  // The last marker may have overshot; slice to the exact requested length.\n74\t  return out.join('').slice(0, bytes);\n75\t}\n76\t\n77\t/** CLI entry: parse the size arg, write exactly that many bytes to stdout. */\n78\tfunction main() {\n79\t  const bytes = parseSize(process.argv[2]);\n80\t  process.stdout.write(buildPayload(bytes));\n81\t}\n82\t\n83\tif (import.meta.url === `file://${process.argv[1]}`) {\n84\t  main();\n85\t}\n86\t",
