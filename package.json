{
  "name": "@faithfulalabi/agent-lens",
  "version": "0.1.1",
  "description": "Local-first agentic tracing platform: inspect everything your agent did in a session.",
  "type": "module",
  "license": "MIT",
  "author": "Faithful Alabi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithfulalabi/agent-lens.git"
  },
  "homepage": "https://github.com/faithfulalabi/agent-lens#readme",
  "bugs": "https://github.com/faithfulalabi/agent-lens/issues",
  "keywords": [
    "claude-code",
    "agent",
    "tracing",
    "observability",
    "transcripts",
    "local-first",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-lens": "bin/agent-lens.js"
  },
  "files": [
    "bin",
    "dist",
    "ui/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/dev/server.ts",
    "dev:ui": "npm --prefix ui run dev",
    "render-gate": "tsx src/render-gate/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && npm --prefix ui run typecheck",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm --prefix ui run build",
    "smoke:pack": "node --import tsx scripts/pack-smoke.mjs",
    "smoke:ui": "playwright test",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "prepare": "npm --prefix ui install"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^3.23.2",
    "globals": "^15.15.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
